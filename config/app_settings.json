{
  "theme": "dark",
  "language": "en",
  "auto_save_interval_seconds": 300,
  "max_ram_usage_mb": 6144,
  "temp_folder_path": "temp",
  "projects_folder_path": "projects",
  "log_level": "info",
  "auto_render_mode": true,
  "default_channel_profile": "default",
  "ffmpeg_path": "engines/ffmpeg/ffmpeg",
  "ffprobe_path": "engines/ffmpeg/ffprobe",
  "hardware_acceleration": "auto",
  "proxy_resolution": 480,
  "cache_size_mb": 2048,
  "render_segment_duration_seconds": 30,
  "checkpoint_interval_seconds": 30,
  "database_path": "database/autopilot.db",
  "show_splash": true,
  "auto_open_output": true,
  "auto_play_output": false,
  "notify_on_complete": true,
  "sound_on_complete": true,
  "subtitle_burn_default": true,
  "auto_generate_subtitles": true,
  "auto_generate_thumbnails": true,
  "thumbnail_count": 5,
  "ducking_enabled": true,
  "batch_retry_count": 3,
  "batch_stop_on_error": false,
  "trial_days": 30,
  "output_naming": "{title}_{resolution}_{date}",
  "startup_ram_target_mb": 150,
  "paragraph_narration_enabled": true,
  "natural_pauses_enabled": true,
  "narration_pause_base_seconds": 0.25,
  "narration_pause_min_seconds": 0.05,
  "narration_pause_max_seconds": 2.5,
  "narration_pause_jitter": 0.12,
  "narration_breath_interval_seconds": 14.0,
  "prosody_enhancement_enabled": true,
  "prosody_emphasis_strength": 0.72,
  "prosody_intonation_strength": 0.68,
  "prosody_transition_smoothing": 0.22,
  "prosody_phrase_max_words": 11,
  "prosody_max_emphasized_words": 4,
  "image_match_priorities": [
    "user_uploads",
    "library",
    "placeholder"
  ],
  "image_match_phase_a_modes": [
    "exact_filename",
    "fuzzy_filename"
  ]
}
