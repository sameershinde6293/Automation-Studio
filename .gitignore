# Python
backend/venv/
backend/.venv/
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Databases (local runtime state)
*.db
*.db-journal
*.db-wal
*.db-shm

# Node / frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-electron/
frontend/dist-electron-app/
frontend/coverage/
