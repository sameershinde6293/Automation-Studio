{
  "name": "02 · AI Content Pipeline",
  "description": "Two-stage AI chain: a prompt template feeds a chat node, whose output is summarised by a second chat node. Uses the provider fallback chain, so it runs against the built-in mock provider with no API key and switches to OpenAI or Ollama purely by configuration.",
  "version": "1.0.0",
  "creator_os": {
    "min_version": "1.1.0",
    "requires": [],
    "optional": [
      "OPENAI_API_KEY for the openai provider",
      "OLLAMA_BASE_URL for a local model"
    ],
    "runtime_seconds": 5,
    "demonstrates": ["prompt templating", "AI chat", "provider fallback", "chained AI stages", "retry policy"],
    "notes": "provider is left blank so AI_FALLBACK_CHAIN decides. With no credentials configured the chain ends at 'mock', which returns deterministic text — the workflow still completes."
  },
  "nodes": [
    {
      "id": 1,
      "name": "Start",
      "node_type": "start",
      "position_x": 40,
      "position_y": 180,
      "config": {
        "variables": {
          "topic": "workflow automation for small teams",
          "audience": "technical founders"
        }
      }
    },
    {
      "id": 2,
      "name": "BuildBrief",
      "node_type": "prompt_template",
      "position_x": 250,
      "position_y": 180,
      "config": {
        "template": "Write three short bullet points about {{ Start.variables.topic }} aimed at {{ Start.variables.audience }}. Be concrete and avoid marketing language.",
        "system": "You are a concise technical writer."
      }
    },
    {
      "id": 3,
      "name": "Draft",
      "node_type": "ai_chat",
      "position_x": 470,
      "position_y": 180,
      "config": {
        "prompt": "{{ BuildBrief.prompt }}",
        "system": "You are a concise technical writer.",
        "provider": "",
        "temperature": 0.7,
        "max_tokens": 400,
        "allow_fallback": true,
        "use_memory": false
      },
      "retry_policy": {
        "max_attempts": 3,
        "backoff_seconds": 2
      }
    },
    {
      "id": 4,
      "name": "Summarise",
      "node_type": "ai_chat",
      "position_x": 690,
      "position_y": 180,
      "config": {
        "prompt": "Compress the following into a single sentence of at most 25 words:\n\n{{ Draft.response }}",
        "system": "You compress text without losing meaning.",
        "provider": "",
        "temperature": 0.2,
        "max_tokens": 120,
        "allow_fallback": true,
        "use_memory": false
      },
      "retry_policy": {
        "max_attempts": 3,
        "backoff_seconds": 2
      }
    },
    {
      "id": 5,
      "name": "End",
      "node_type": "end",
      "position_x": 910,
      "position_y": 180,
      "config": {
        "output": "{{ Summarise.response }}",
        "status": "success"
      }
    }
  ],
  "edges": [
    { "source_id": 1, "target_id": 2, "label": null },
    { "source_id": 2, "target_id": 3, "label": null },
    { "source_id": 3, "target_id": 4, "label": null },
    { "source_id": 4, "target_id": 5, "label": null }
  ]
}
