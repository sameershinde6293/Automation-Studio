# Creator OS backend configuration.
# Copy to .env and adjust. All values are optional; defaults are shown.

# --- Identity ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json
LOG_FILE=                   # e.g. ./logs/creator-os.log

# --- Database ---
DATABASE_URL=sqlite:///./creator_os.db
DB_ECHO=false

# --- HTTP / security ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
ENABLE_DOCS=true

# --- Workflow engine ---
WORKFLOW_MAX_PARALLEL_NODES=8
WORKFLOW_NODE_TIMEOUT_SECONDS=300
WORKFLOW_MAX_RETRIES=3

# --- Node executor safety ---
# The shell executor can run local commands. It is DISABLED by default.
# Enable it only if you understand the risk, and always set an allowlist.
ALLOW_SHELL_EXECUTOR=false
SHELL_ALLOWED_COMMANDS=
HTTP_EXECUTOR_ALLOW_PRIVATE_NETWORKS=false
HTTP_EXECUTOR_ALLOWED_HOSTS=

# --- AI runtime ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434/api

# --- Media pipeline ---
MEDIA_ROOT=./media_storage
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
