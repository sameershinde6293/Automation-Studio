{
    "version": "1.0",
    "notes": "Template commands with {placeholders} replaced at runtime",
    "commands": {
        "get_duration": "ffprobe -v quiet -print_format json -show_format {input}",
        "get_info": "ffprobe -v quiet -print_format json -show_format -show_streams {input}",
        "convert_audio_to_wav": "ffmpeg -i {input} -ar 48000 -ac 2 -acodec pcm_s16le {output}",
        "normalize_audio": "ffmpeg -i {input} -af loudnorm=I={target_lufs}:LRA=11:TP=-1 {output}",
        "apply_audio_filters": "ffmpeg -i {input} -af {filter_chain} {output}",
        "image_to_video_animated": "ffmpeg -loop 1 -i {input} -t {duration} -vf zoompan={zoompan_params},scale={width}:{height},setsar=1 -c:v libx264 -r {fps} -pix_fmt yuv420p -an {output}",
        "image_to_video_with_grade": "ffmpeg -loop 1 -i {input} -t {duration} -vf zoompan={zoompan_params},{grade_filters},scale={width}:{height},setsar=1 -c:v libx264 -r {fps} -pix_fmt yuv420p -an {output}",
        "apply_lut": "ffmpeg -i {input} -vf lut3d={lut_file} {output}",
        "concat_with_transitions": "ffmpeg {input_flags} -filter_complex {filter_complex} -map [out] -c:v libx264 {output}",
        "burn_subtitles": "ffmpeg -i {input} -vf subtitles={srt_file}:force_style='{style_string}' -c:a copy {output}",
        "add_audio_to_video": "ffmpeg -i {video} -i {audio} -c:v copy -c:a aac -b:a {audio_bitrate} -map 0:v -map 1:a {output}",
        "final_encode_software": "ffmpeg -i {input} -c:v libx264 -preset {preset} -crf {crf} -b:v {bitrate} -pix_fmt yuv420p -c:a aac -b:a {audio_bitrate} -ar 48000 -ac 2 -movflags +faststart {output}",
        "final_encode_nvenc": "ffmpeg -i {input} -c:v h264_nvenc -preset p7 -cq {crf} -b:v {bitrate} -pix_fmt yuv420p -c:a aac -b:a {audio_bitrate} -ar 48000 -ac 2 -movflags +faststart {output}",
        "final_encode_amf": "ffmpeg -i {input} -c:v h264_amf -quality quality -b:v {bitrate} -pix_fmt yuv420p -c:a aac -b:a {audio_bitrate} -ar 48000 -ac 2 -movflags +faststart {output}",
        "final_encode_qsv": "ffmpeg -i {input} -c:v h264_qsv -preset slow -b:v {bitrate} -pix_fmt yuv420p -c:a aac -b:a {audio_bitrate} -ar 48000 -ac 2 -movflags +faststart {output}",
        "drawtext_word": "drawtext=text='{word}':fontfile={font}:fontsize={size}:fontcolor={color}:x=(w-text_w)/2:y=h-{margin}:enable='between(t,{start},{end})'",
        "add_watermark": "ffmpeg -i {input} -i {watermark} -filter_complex overlay={position}:alpha={opacity} -c:a copy {output}",
        "extract_frame": "ffmpeg -i {input} -ss {timestamp} -vframes 1 {output}",
        "audio_mix_5track": "ffmpeg -i {narration} -i {music} -i {sfx_trans} -i {sfx_key} -i {ambient} -filter_complex [0:a]volume={narr_vol}[n];[1:a]volume={music_vol}[m];[2:a]volume={sfx_t_vol}[s1];[3:a]volume={sfx_k_vol}[s2];[4:a]volume={amb_vol}[a];[n][m][s1][s2][a]amix=inputs=5:duration=first[mix];[mix]loudnorm=I=-14:LRA=11:TP=-1[out] -map [out] -ar 48000 -ac 2 {output}"
    },
    "filter_templates": {
        "vignette": "vignette={angle}:eval=frame",
        "film_grain": "noise=c0s={amount}:c0f=t+u",
        "color_grade_full": "eq=brightness={br}:contrast={co}:saturation={sa}:gamma={ga},colorbalance=rs={rs}:gs={gs}:bs={bs}:rm={rm}:gm={gm}:bm={bm}:rh={rh}:gh={gh}:bh={bh}",
        "sharpen": "unsharp=5:5:{amount}:5:5:0",
        "blur": "boxblur={amount}",
        "high_pass_audio": "highpass=f={frequency}",
        "low_pass_audio": "lowpass=f={frequency}",
        "reverb_subtle": "aecho=0.9:0.85:20|35:0.10|0.05",
        "reverb_small_room": "aecho=0.85:0.80:30|60|90:0.15|0.08|0.04",
        "reverb_medium_room": "aecho=0.80:0.75:50|100|150:0.25|0.12|0.06",
        "reverb_large_hall": "aecho=0.75:0.70:60|120|200|300:0.35|0.20|0.10|0.05",
        "reverb_cathedral": "aecho=0.70:0.65:80|160|300|500|700:0.50|0.35|0.20|0.10|0.05",
        "audio_compressor": "acompressor=threshold={threshold}:ratio={ratio}:attack={attack}:release={release}:makeup={makeup}",
        "audio_noise_gate": "agate=threshold={threshold}:ratio={ratio}:attack={attack}:release={release}",
        "audio_limiter": "alimiter=limit={limit}:level=false",
        "loudnorm": "loudnorm=I={lufs}:LRA=11:TP=-1",
        "stereo_widen": "stereowiden=s={amount}",
        "pitch_shift": "asetrate={sr}*{factor},aresample={sr}",
        "telephone_effect": "highpass=f=300,lowpass=f=3400,acompressor=threshold=-20dB:ratio=4",
        "old_radio_effect": "highpass=f=400,lowpass=f=4000,aecho=0.9:0.85:8:0.04"
    }
}
