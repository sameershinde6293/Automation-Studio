# Creator OS - systemd unit for source-based deployment (without Docker)
# This is an alternative to docker-compose for hosts without container runtime.
# It runs the backend as a systemd service with auto-restart, logging to journal.
#
# Installation:
#   sudo cp deploy/systemd/creator-os.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable creator-os
#   sudo systemctl start creator-os
#   sudo journalctl -u creator-os -f
#
# Prerequisites:
# - Python 3.11+ with venv at /opt/creator-os/backend/.venv
# - PostgreSQL running and DATABASE_URL set
# - .env file at /opt/creator-os/.env with mandatory secrets
# - User `creator` exists (useradd -r -m -s /bin/bash creator)

[Unit]
Description=Creator OS Backend
After=network.target postgresql.service
Requires=postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=creator
Group=creator
WorkingDirectory=/opt/creator-os/backend
EnvironmentFile=/opt/creator-os/.env
# Override with explicit production settings (env file takes precedence, but
# these are safety defaults if .env is incomplete - startup validation will
# still reject unsafe configs)
Environment=ENVIRONMENT=production
Environment=LOG_FORMAT=json
Environment=HOST=127.0.0.1
Environment=PORT=8000

# Ensure .venv exists
ExecStartPre=/bin/bash -c 'test -d /opt/creator-os/backend/.venv || (python3 -m venv /opt/creator-os/backend/.venv && /opt/creator-os/backend/.venv/bin/pip install -r /opt/creator-os/backend/requirements.txt)'
ExecStartPre=/opt/creator-os/backend/.venv/bin/alembic upgrade head

ExecStart=/opt/creator-os/backend/.venv/bin/uvicorn app.main:app --host ${HOST} --port ${PORT} --workers 1 --proxy-headers --forwarded-allow-ips='*'

# Restart policy - matches docker-compose restart: unless-stopped
Restart=always
RestartSec=5s

# Resource limits - match docker-compose deploy.resources.limits
MemoryMax=2G
CPUQuota=200%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/creator-os/backend /data /var/log/creator-os
AmbientCapabilities=
CapabilityBoundingSet=

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=creator-os

# Timeout for graceful shutdown (SIGTERM -> SIGKILL)
TimeoutStopSec=30s
KillMode=mixed

[Install]
WantedBy=multi-user.target
