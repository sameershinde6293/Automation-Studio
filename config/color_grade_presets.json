        {
            "id": "dark_moody",
            "name": "Dark Moody",
            "description": "Deep shadows, desaturated, cool blue tones. Best for dark history and mystery content.",
            "genre_match": [
                "dark_history",
                "mystery",
                "horror_documentary"
            ],
            "ffmpeg_eq": "brightness=-0.05:contrast=1.20:saturation=0.70:gamma=0.90",
            "ffmpeg_colorbalance": "rs=-0.10:gs=-0.05:bs=0.10:rm=-0.05:gm=0.00:bm=0.05:rh=-0.05:gh=0.00:bh=0.05",
            "vignette_enabled": true,
            "vignette_strength": 0.7,
            "vignette_angle": 0.785,
            "film_grain_enabled": true,
            "film_grain_amount": 0.04,
            "film_grain_size": 2,
            "dust_overlay_enabled": false,
            "scratch_overlay_enabled": false,
            "lut_file": "dark_moody.cube",
            "lut_opacity": 0.8,
            "sharpen_enabled": true,
            "sharpen_amount": 0.3,
            "color_temperature": "cool",
            "preview_color": "#1A1A3E"
        },
