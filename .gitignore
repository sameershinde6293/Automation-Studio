# Python bytecode / cache (never tracked, any depth)
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# Virtualenvs
venv/
.venv/

# Build outputs (D.5)
build/Autopilot/
dist/

# Runtime state (never commit user data)
database/autopilot.db
database/*.db-wal
database/*.db-shm
logs/
temp/
cache/
projects/
subtitles/

# Engine binaries (provision per machine; never in git)
engines/

# Local test scratch
.pytest_base/
smoke_out/
