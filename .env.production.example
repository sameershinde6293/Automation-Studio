# Creator OS — production configuration template.
#
#   cp .env.production.example .env
#
# Referenced by docker-compose.yml and docs/DEPLOYMENT.md. Added in M6: the
# file was referenced by both but had never been committed (finding M6-F4), so
# the documented quick start failed at its first step.
#
# List-valued settings accept EITHER a comma-separated string (shown below) or
# a JSON array. M6 fixed the settings loader so the comma-separated form no
# longer crashes the process at import (finding M6-F1).
#
# Every value marked REQUIRED has no usable default. Startup validation
# (app/core/startup.py) refuses to boot a production process that is missing
# one, so a mistake here fails loudly at deploy time rather than silently.

# =============================================================================
# Identity
# =============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json                       # json is required for log aggregation
LOG_FILE=                             # empty = stdout (correct for containers)

# =============================================================================
# Database — REQUIRED
# =============================================================================
# PostgreSQL only. SQLite is single-writer and cannot back more than one
# process; startup validation warns if you use it in production.
# docker-compose builds this URL for you from POSTGRES_* below.
POSTGRES_USER=creator
POSTGRES_PASSWORD=                    # REQUIRED — python3 -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_DB=creator_os
# DATABASE_URL=postgresql+psycopg://creator:PASSWORD@db:5432/creator_os

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# =============================================================================
# Authentication — REQUIRED
# =============================================================================
# AUTH_ENABLED=false in production is a hard startup error: it would treat
# every anonymous caller as a local administrator.
AUTH_ENABLED=true

# REQUIRED. 32+ chars of real entropy, unique per deployment. Rotating this
# invalidates every issued access and refresh token.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

AUTH_ACCESS_TOKEN_TTL_SECONDS=900     # 15 minutes
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600  # 14 days
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900
AUTH_ALLOW_SELF_REGISTRATION=false    # keep false for an internal platform

# First-run administrator. Set these for the FIRST boot only, then clear them
# and restart — startup validation warns for as long as they are present.
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=

# =============================================================================
# HTTP surface — REQUIRED
# =============================================================================
# Exact browser origins. "*" is a hard startup error while credentials are
# allowed. Comma-separated.
CORS_ORIGINS=https://studio.example.com

# Hostnames this service is served on. Blocks host-header injection and DNS
# rebinding. "*" (the desktop default) warns in production.
ALLOWED_HOSTS=studio.example.com

ENABLE_DOCS=false                     # do not expose Swagger publicly
SECURITY_HSTS_ENABLED=true            # requires TLS in front
SECURITY_HSTS_MAX_AGE=31536000
CSRF_PROTECTION_ENABLED=true

# Only true when a proxy you control sets X-Forwarded-For. If the backend is
# reachable directly, this lets any client spoof its IP and evade rate limits.
TRUST_PROXY_HEADERS=true

MAX_REQUEST_BYTES=26214400            # 25 MiB

# =============================================================================
# Rate limiting
# =============================================================================
# In-process and therefore PER WORKER: with WEB_CONCURRENCY=N the effective
# limit is N x the value below. See docs/DEPLOYMENT.md "Scalability".
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Observability
# =============================================================================
METRICS_ENABLED=true
# Leave false only when /metrics is unreachable from outside the private
# network; true requires the manage_settings permission to scrape.
METRICS_REQUIRE_AUTH=false
ERROR_AGGREGATION_SIZE=500

# =============================================================================
# Execution engine
# =============================================================================
# Executions run in-process on the API worker. Size against the container CPU
# limit, not the host. See docs/M6_VALIDATION_REPORT.md for measured numbers.
EXECUTION_MAX_WORKERS=4
EXECUTION_QUEUE_MAX_SIZE=1000
EXECUTION_TIMEOUT_SECONDS=3600
WORKFLOW_MAX_PARALLEL_NODES=8
WORKFLOW_NODE_TIMEOUT_SECONDS=300
WORKFLOW_MAX_NODES=1000
WORKFLOW_MAX_LOOP_ITERATIONS=1000
WORKFLOW_MAX_NODE_EXECUTIONS=10000

# =============================================================================
# Script executors — DANGEROUS, disabled by default
# =============================================================================
# The sandbox is defence in depth, NOT a security boundary. Read
# docs/SECURITY.md before enabling any of these. Only enable when every
# workflow author is trusted with the backend user's OS privileges.
ALLOW_PYTHON_EXECUTOR=false
ALLOW_JAVASCRIPT_EXECUTOR=false
ALLOW_SHELL_EXECUTOR=false
SHELL_ALLOWED_COMMANDS=               # empty + enabled = hard startup error
ALLOW_DATABASE_EXECUTOR=false

SCRIPT_SANDBOX_ENABLED=true           # false + a script node enabled = error
SCRIPT_SANDBOX_CPU_SECONDS=10
SCRIPT_SANDBOX_MEMORY_MB=256
SCRIPT_SANDBOX_BLOCK_NETWORK=true
SCRIPT_EXECUTION_QUOTA_PER_RUN=100

# SSRF protection. true lets workflows reach internal services and cloud
# metadata endpoints (169.254.169.254) — a hard startup error in production.
HTTP_EXECUTOR_ALLOW_PRIVATE_NETWORKS=false
HTTP_EXECUTOR_ALLOWED_HOSTS=          # empty = any public host
HTTP_EXECUTOR_TIMEOUT_SECONDS=30

# =============================================================================
# AI providers
# =============================================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434/api
AI_REQUEST_TIMEOUT_SECONDS=120
AI_FALLBACK_CHAIN=openai,local,mock
AI_CIRCUIT_BREAKER_THRESHOLD=5

# =============================================================================
# Media pipeline
# =============================================================================
MEDIA_ROOT=/data/media                # must be a persistent volume
MEDIA_MAX_FILE_BYTES=2147483648       # 2 GiB
MEDIA_MAX_CONCURRENT_JOBS=2
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# =============================================================================
# Serving
# =============================================================================
HTTP_PORT=8080                        # host port the frontend is published on
# Uvicorn worker processes. >1 multiplies the in-process rate limit and gives
# each worker its own execution queue — read the Scalability section of
# docs/DEPLOYMENT.md before raising this.
WEB_CONCURRENCY=1
